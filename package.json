    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:report": "jest && echo 'Report generated at test-report/index.html'",
    "telegram": "npx tsx ./src/telegram.js",
    "allure": "allure serve reports/allure-results",
    "allure:clean": "rimraf reports/allure-results",
    "allure:test": "run-s allure:clean test allure:history allure:ci",
    "allure:history": "node scripts/allure-history.mjs",
    "allure:ci": "allure generate reports/allure-results --clean -o reports/allure-reports",
    "allure:ci:show": "allure open reports/allure-reports"
